# Agent Shopper runs entirely free/local without any of these -- copy this
# file to .env and fill in a key only if you want to exercise the LLM
# Semantic Ranking upgrade path (see agent_shopper/reranker.py).
#
# At most one of these is used: OPENAI_API_KEY is tried first, then
# ANTHROPIC_API_KEY. Never commit a real .env file (it's gitignored).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides -- see agent_shopper/config.py for the full list of
# tunable env vars (thresholds, weights, etc.), all prefixed AGENT_SHOPPER_.
AGENT_SHOPPER_RERANK_MODEL=gpt-4o-mini
AGENT_SHOPPER_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Set to 1 to force the free/local heuristic path even when a key is
# present above -- useful for fast, zero-cost local tuning iterations.
AGENT_SHOPPER_FORCE_HEURISTIC=0
